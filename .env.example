# --- LLM judge (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-flash
JUDGE_TEMPERATURE=0.2
JUDGE_MAX_TOKENS=8000
JUDGE_TIMEOUT_S=180
# DeepSeek thinking mode: disabled (default, see DECISIONS D9) or enabled
JUDGE_THINKING=disabled
# Judge design: direct (LLM scores criteria) or facts (LLM extracts facts, code scores) - DECISIONS D10
JUDGE_DESIGN=direct
# Label aggregation: problems (count of criteria scored <= 2) or mean (weighted mean) - DECISIONS D12
AGGREGATION=problems

# --- Binaries (Windows dev paths; Linux/Docker uses ffmpeg, ffprobe, whisper-cli on PATH) ---
FFMPEG_BIN=D:\tools\ffmpeg\bin\ffmpeg.exe
FFPROBE_BIN=D:\tools\ffmpeg\bin\ffprobe.exe
WHISPER_CLI=D:\tools\whisper.cpp\Release\whisper-cli.exe
# base-q5_1 at 2 threads: 0.17x real time, same agreement as turbo on the benchmark clip (DECISIONS D11)
WHISPER_MODEL=models/ggml-base-q5_1.bin
WHISPER_THREADS=2
WHISPER_LANGUAGE=auto

# --- Data and cache ---
# Folder that contains the extracted "class recordings" folder (outside the repo)
DATA_DIR=D:\IIT CODES\PROJECTS\Humaniti AI\data
CACHE_DIR=.cache

# --- Pipeline ---
FRAME_INTERVAL_SEC=30
FACE_MODEL=models/face_detection_yunet_2023mar.onnx
OPENING_WINDOW_MIN=10
CLOSING_WINDOW_MIN=10
# Evidence quotes must match the transcript within +- this many seconds
EVIDENCE_WINDOW_S=90

# --- Visual thresholds (initial guesses; check with eval, do not fit to 10 samples) ---
VISUAL_MIN_FACE_PCT=60
VISUAL_MAX_DARK_PCT=20
VISUAL_MAX_BLACK_PCT=10
VISUAL_MAX_FROZEN_PCT=30
