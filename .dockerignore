# Nothing confidential may enter the image: secrets, data, caches, recordings, transcripts, eval outputs.
# secrets
**/.env
**/.env.*
!.env.example
# environments and tool caches
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.git/
.claude/
# data, caches and derived files
data/
.cache/
eval/
frames/
logs/
models/
tests/
**/*.mp4
**/*.mkv
**/*.mov
**/*.webm
**/*.wav
**/*.mp3
**/*.m4a
**/*.vtt
**/*.srt
**/*.zip
**/*.pdf
**/*.jpg
**/*.png
